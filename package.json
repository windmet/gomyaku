{
  "name": "gomyaku",
  "private": true,
  "version": "0.1.0-alpha.4",
  "description": "Generic archive model, validation, projections, and deterministic compiler.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node scripts/verify-fixtures.mjs",
    "verify:package": "node scripts/verify-package-surface.mjs",
    "validate": "npm test && npm run verify:package && npm exec -- tsc --noEmit",
    "compile": "node src/cli/gomyaku.mjs compile"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./compiler/project": "./src/compiler/compileProject.mjs",
    "./model/project-schema": "./src/model/projectSchema.ts",
    "./projections/project-people": "./src/projections/projectPeople.ts",
    "./projections/project-presentation": "./src/projections/projectPresentation.mjs",
    "./validation/project-package": "./src/validation/projectPackage.mjs",
    "./validation/source-set": "./src/validation/sourceSet.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
